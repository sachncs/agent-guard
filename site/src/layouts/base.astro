---
import '@/styles/globals.css';
import '@fontsource-variable/geist/index.css';
import '@fontsource-variable/geist-mono/index.css';
interface Props { title?: string; description?: string; }
const { title = 'AgentGuard — Authorization infrastructure for AI agents', description = 'Put a Cedar policy boundary between agent intent and tool execution. Open-source authorization, scoped delegation primitives, and verifiable audit records.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://sachncs.github.io').href;
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#101716"/><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:site_name" content="AgentGuard"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://sachncs.github.io/agent-guard/og-image.svg"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://sachncs.github.io/agent-guard/og-image.svg"/><link rel="sitemap" href={`${base}sitemap-index.xml`}/></head><body><a class="skip-link" href="#main">Skip to content</a><slot/></body></html>
