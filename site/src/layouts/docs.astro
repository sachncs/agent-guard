---
import Base from '@/layouts/base.astro';
import Header from '@/components/product/Header.astro';
import Footer from '@/components/product/Footer.astro';
const base=import.meta.env.BASE_URL;
const sections=[['Overview',''],['Getting started','getting-started/'],['Core concepts','concepts/'],['Architecture & deployment','deploy/'],['Production deployment','production/'],['Kubernetes operations','kubernetes/'],['Console deployment','console/'],['API & SDKs','api/'],['Identity & delegation','identity/'],['Audit & observability','audit/'],['Configuration','configuration/'],['Operations','operations/'],['Incident response','incident-response/'],['Security model','security/'],['Compatibility','compatibility/'],['Brand system','branding/']];
interface Props {title:string; description?:string; active?:string;}
const {title,description='AgentGuard documentation: authorization, integration, and operational boundaries.'}=Astro.props;
---
<Base title={`${title} — AgentGuard documentation`} description={description}><Header/><div class="container docs-layout"><aside class="docs-sidebar"><nav aria-label="Documentation"><div class="docs-sidebar-title">BUILD & OPERATE</div>{sections.map(([label,path])=><a href={`${base}docs/${path}`} aria-current={Astro.url.pathname===`${base}docs/${path}`?'page':undefined}>{label}</a>)}<div class="docs-sidebar-title">SOURCE & PROJECT</div><a href="https://github.com/sachncs/agent-guard/tree/master/examples">Examples ↗</a><a href="https://github.com/sachncs/agent-guard/blob/master/CHANGELOG.md">Changelog ↗</a><a href="https://github.com/sachncs/agent-guard/blob/master/SECURITY.md">Security reporting ↗</a></nav></aside><main class="docs-main" id="main"><slot/></main></div><Footer/></Base>
