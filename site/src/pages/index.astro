---
import Base from '@/layouts/base.astro';
import Header from '@/components/product/Header.astro';
import Footer from '@/components/product/Footer.astro';
import Snippet from '@/components/product/Snippet.astro';
import Integrations from '@/components/product/Integrations.astro';
import { PolicyPlayground } from '@/components/policy-playground';
import { policy } from '@/data/examples';
const base = import.meta.env.BASE_URL;
const docs = `${base}docs/`;
const repo = 'https://github.com/sachncs/agent-guard';
const lifecycle = [['Intercept','Your adapter catches the proposed tool call before execution.'],['Resolve identity','Authenticate the caller and derive the acting principal in trusted application code.'],['Build the request','Map principal, action, resource, context, and required entities.'],['Evaluate','The Cedar authorizer returns allow or deny with policy diagnostics.'],['Record','The configured server audit log receives the decision before it is returned.'],['Return','The PDP responds to the adapter. Errors are not permission.'],['Enforce','Your adapter executes only on an explicit allow.'],['Observe','Inspect decision metrics and trace context; connect telemetry sinks where needed.']];
const standards = [['Cedar 4.x','Policy language','The Rust engine evaluates typed authorization requests.','crates/agentguard-core/Cargo.toml'],['OpenID AuthZEN draft','Decision interface','HTTP single and batch evaluation; a repository-defined gRPC mirror.','crates/agentguard-server/src/authzen.rs'],['W3C Trace Context','Request correlation','HTTP traceparent input and child span identifiers.','crates/agentguard-core/src/observability/mod.rs'],['RFC 7519 · RFC 8725','JWT validation','Library checks signatures, issuer, audience, and time claims.','crates/agentguard-auth/src/jwt.rs'],['RFC 8414','Issuer discovery','OIDC library metadata discovery with issuer validation.','crates/agentguard-auth/src/oidc.rs'],['RFC 9449','Proof of possession','DPoP verifier library checks binding, signature, method, URI, and replay.','crates/agentguard-auth/src/dpop.rs'],['SPIFFE X.509-SVID','Workload identity','Feature-gated Workload API client with trust-domain validation.','crates/agentguard-auth/src/spiffe.rs'],['RFC 8693 · RFC 8707','Delegation concepts','Actor and audience claims are building blocks; no token-exchange endpoint or resource-parameter API is exposed.','crates/agentguard-core/src/delegation.rs']];
const modules = [['crates/agentguard-core','agentguard-core','Cedar, entities, audit, cache, delegation'],['crates/agentguard-server','agentguard-server','HTTP and gRPC decision interfaces'],['crates/agentguard-cli','agentguard-cli','Local policy and audit commands'],['crates/agentguard-auth','agentguard-auth','Identity validation primitives'],['crates/agentguard-policy','agentguard-policy','Bundles, diff, replay analysis, watcher'],['crates/agentguard-telemetry','agentguard-telemetry','Metrics and pluggable event sinks'],['typescript/agentguard','typescript/agentguard','Node.js CLI-backed SDK'],['frontend','frontend','Optional OIDC-protected console'],['examples','examples','Strands and Rust router examples'],['schemas','schemas','Starter Cedar schema'],['site','site','This static Astro product site']];
const faqs = [['Is AgentGuard a hosted service?','No. It is Apache-2.0 software you deploy and operate. The public website has no hosted authorization backend.'],['Does it prevent prompt injection?','It constrains the actions a policy allows at an enforced tool boundary. It does not detect every malicious prompt, inspect model reasoning, or protect an unguarded execution path.'],['What happens if no policy matches?','Cedar denies by default. An applicable permit is required; an applicable forbid overrides permits. Replace broad generated starter policies before deployment.'],['Can I use my existing framework or LLM?','Yes, through an adapter that calls the HTTP PDP, CLI, or embedded Rust engine before execution. Strands has a repository example; other frameworks require integration work.'],['Where should authorization happen?','Immediately before a tool executes, using the actual target and arguments. Guard every relevant execution path, including retries and delegated calls.'],['Can it run as a sidecar or embedded?','The standalone server can run beside your application or as a shared PDP. Rust applications can use Authorizer in-process or mount build_router. Embedders own lifecycle and security configuration.'],['How are audit records protected?','Configure a chain secret to enable HMAC-SHA256 linked records. Protect the key, retain trusted chain checkpoints, and verify logs offline; a chain alone does not prove completeness.'],['How does delegation work?','The CLI and Rust primitives mint scoped, time-limited Ed25519 JWS tokens. Applications must verify tokens and enforce their action/resource scopes alongside Cedar.'],['What if the PDP is unavailable?','Stop execution. The Strands guard fails closed on transport errors and non-allow results. Custom adapters must implement the same behavior.'],['Which request context should be trusted?','Derive identity, MFA, ownership, and environment from trusted systems. API keys are bound to one User or Agent subject and the PDP rejects requests that claim a different subject. Tenant metadata is not automatically a Cedar policy attribute; encode tenant isolation explicitly in trusted entities and policies.']];
---
<Base><Header/><main id="main">
<section class="hero"><div class="container"><span class="eyebrow"><span class="status-dot"></span> OPEN-SOURCE AUTHORIZATION CONTROL PLANE</span><div class="hero-layout"><div><h1>Give every AI action<br/><span>a policy boundary.</span></h1><p class="hero-lede">AgentGuard evaluates proposed tool calls against Cedar policies before your application executes them. Separate intent from permission, and keep a record of the decision.</p><div class="actions"><a class="button primary" href={`${docs}getting-started/`}>Read the quickstart <span>→</span></a><a class="button" href={repo}>View on GitHub ↗</a></div><div class="hero-tags"><span>Apache-2.0</span><span>Rust + Cedar</span><span>Self-hosted</span></div></div>
<div class="decision-panel" id="hero-decision"><div class="panel-head"><span><span class="status-dot"></span> AUTHORIZATION REQUEST</span><span>ILLUSTRATIVE</span></div><dl class="request-fields"><div><dt>PRINCIPAL</dt><dd>Agent::"research"</dd></div><div><dt>ACTION</dt><dd>Action::"ToolCall::repo_read"</dd></div><div><dt>RESOURCE</dt><dd>Repository::"demo"</dd></div><div><dt>CONTEXT</dt><dd>session.mfa: <span id="hero-mfa">true</span></dd></div></dl><div class="evaluation" aria-live="polite"><span class="caption">01 REQUEST → 02 POLICY → 03 DECISION</span><strong id="hero-effect">ALLOW</strong><p id="hero-reason">Principal, action, resource, and MFA match.</p></div><div class="panel-foot"><span id="hero-audit">Sample audit: effect = allow</span><button class="hero-test" id="hero-toggle" type="button">Try without MFA ↗</button></div></div></div><div class="hero-bottom"><span>Infrastructure authorization at the tool boundary. Policy stays outside model reasoning.</span><a href="#how-it-works">Follow a request ↓</a></div></div></section>
<section class="section" id="product"><div class="container"><div class="section-heading"><div><span class="section-kicker">01 / INTENT ≠ PERMISSION</span><h2>A tool call is a proposal.<br/><span>Make permission explicit.</span></h2></div><p>A model can choose an action. Your application still needs to decide whether that principal may perform it on that resource, in this context.</p></div><div class="problem-grid"><div class="boundary"><span class="caption">An unguarded execution path</span><div class="boundary-flow"><span>Agent intent</span><span>→</span><span>Tool execution</span></div><p>Access follows whatever credentials the tool happens to hold.</p></div><div class="boundary good"><span class="caption">A policy enforcement point</span><div class="boundary-flow"><span>Agent</span><span>→</span><b>AgentGuard</b><span>→</span><span>Tool</span></div><p>Your adapter asks for a decision and executes only on allow.</p></div></div><div class="model-grid">{[['P','Principal','Agent::"research"','Who is asking? A user or an agent.'],['A','Action','Action::"ToolCall::repo_read"','What operation is being proposed?'],['R','Resource','Repository::"demo"','Which object will the tool touch?'],['C','Context','session.mfa: true','Which trusted facts apply now?']].map(([letter,title,value,body])=><article><span class="caption">{letter} / REQUEST MODEL</span><h3>{title}</h3><code>{value}</code><p>{body}</p></article>)}</div></div></section>
<section class="section" id="how-it-works"><div class="container"><div class="section-heading"><div><span class="section-kicker">02 / REQUEST LIFECYCLE</span><h2>From proposed action<br/><span>to an explicit decision.</span></h2></div><p>The HTTP path joins policy evaluation, configured audit logging, and response handling. Your application supplies identity and owns tool execution.</p></div><ol class="steps">{lifecycle.map(([title,body])=><li><h3>{title}</h3><p>{body}</p></li>)}</ol><p class="note">The embedded engine returns a decision without automatically writing an audit record. The CLI logs by default unless audit is skipped. Step-up is represented in SDK response handling; the current Cedar/server decision path returns allow or deny.</p></div></section>
<section class="section" id="policies"><div class="container split"><div class="prose"><span class="section-kicker">03 / POLICY AS CODE</span><h2>Readable rules.<br/>Reviewable authority.</h2><p>Cedar gives authorization a dedicated language: explicit principals, actions, resources, and conditions. Its Rust engine and typed schema keep policy separate from your tool implementation.</p><div class="feature-rows"><div class="feature-row"><span>01</span><div><h3>Default deny</h3><p>No matching permit means deny. A matching forbid takes precedence.</p></div></div><div class="feature-row"><span>02</span><div><h3>Validate before rollout</h3><p>Keep rules in .agentguard/policies/ and run agentguard validate against schema.cedarschema.</p></div></div><div class="feature-row"><span>03</span><div><h3>Inspect policy changes</h3><p>Rust library APIs provide versioned bundles, line diffs, and replay-based blast-radius analysis. Rollback requires restoring a prior bundle and reloading the authorizer.</p></div></div></div><a class="text-link" href={`${docs}concepts/`}>Policy authoring and operational limits →</a></div><div><Snippet code={policy} lang="text" title=".agentguard/policies/20_agents.cedar"/><div class="note"><strong>One bounded grant.</strong> The principal is research, the action is repo_read, the resource is demo, and verified MFA is required. This rule uses the repository’s starter schema.</div><p class="note">Replace both generated starter policies for this example. The standalone watcher atomically reloads a complete policy snapshot after successful parsing; malformed edits retain the last known-good snapshot.</p></div></div></section>
<section class="section" id="audit"><div class="container split"><div class="prose"><span class="section-kicker">04 / AUDITABILITY</span><h2>A decision you can<br/><span>come back to.</span></h2><p>With a chain secret configured, each audit record links to the previous record using HMAC-SHA256. Verify the chain when investigating a decision or exporting evidence.</p><p>Without a secret, the log is plain JSONL. Protect the secret and preserve an independent trusted checkpoint to detect log replacement or tail truncation.</p><div class="format-list"><span>JSONL</span><span>CEF</span><span>LEEF</span><span>ECS</span></div><Snippet title="Verify and export" code={'agentguard audit verify --secret-file .chain-secret\nagentguard audit export --format ecs --out decisions.ecs.jsonl'}/><a class="text-link" href={`${docs}audit/`}>Record format, verification, and SIEM export →</a></div><div class="chain" id="audit-chain"><div class="chain-label"><span class="caption">ILLUSTRATIVE CHAIN · ABBREVIATED HASHES</span></div>{[['1842','7e2…','a61…','research','allow'],['1843','a61…','b03…','summarizer','deny'],['1844','b03…','c92…','research','allow']].map(([id,prev,hash,principal,effect],i)=><>{i>0&&<div class="chain-connector" aria-hidden="true"/>}<div class="chain-record"><div><span>RECORD #{id}</span><b>{effect.toUpperCase()}</b></div><p>{principal} · repo_read · demo</p><div><span>previous hash</span><code>{prev}</code></div><div><span>record hash</span><code>{hash}</code></div><div><span>timestamp</span><code>sample · 12:00:0{i}Z</code></div></div></>)}<div class="actions"><button class="button small" id="verify-chain" type="button">Trace the sample links ↓</button></div><p class="chain-status" aria-live="polite" id="chain-status">Illustration only. Use the CLI for cryptographic verification.</p></div></div></section>
<section class="section" id="delegation"><div class="container split"><div class="delegation-map"><span class="caption">ILLUSTRATIVE DELEGATION</span><div class="agent-node" style="margin-top:20px"><span class="caption">PARENT</span><code>Agent::"research"</code><p>Application checks the parent’s authority.</p></div><div class="delegation-edge">↓ Signed grant · Ed25519 JWS<br/>Selected action + selected resource + TTL</div><div class="agent-node"><span class="caption">SUB-AGENT</span><code>Agent::"summarizer"</code><p>Action: ToolCall::repo_read<br/>Resource: Repository::demo<br/>TTL: 300 seconds</p></div></div><div class="prose"><span class="section-kicker">05 / SCOPED DELEGATION</span><h2>Pass a bounded grant.<br/>Keep authority explicit.</h2><p>Mint signed tokens with action scopes, resource patterns, and expiry. Verify signatures, audience, and time claims with the Rust verifier.</p><p>Your integration must enforce those scopes and ensure the parent may delegate them. DPoP is a separate verifier library. The standalone PDP does not automatically consume delegation tokens, and there is no delegation revocation endpoint.</p><a class="text-link" href={`${docs}identity/#delegation`}>Understand delegation responsibilities →</a></div></div></section>
<section class="section" id="identity"><div class="container"><div class="section-heading"><div><span class="section-kicker">06 / IDENTITY</span><h2>Know the caller.<br/><span>Then evaluate the action.</span></h2></div><p>Authentication and authorization are separate steps. Map trusted identity into a Cedar principal before submitting a decision request.</p></div><div class="identity-path"><div><b>Identity source</b><p>JWT / OIDC · API keys<br/>SPIFFE workload identity</p></div><span aria-hidden="true">→</span><div><b>Validation & mapping</b><p>Your application validates identity and resolves the acting subject.</p></div><span aria-hidden="true">→</span><div><b>Cedar principal</b><p>User::"alice" or<br/>Agent::"research"</p></div></div><p class="note">Standalone PDP: API-key authentication or local disabled mode. Console: OIDC sign-in with viewer/admin roles. Rust libraries: JWT, OIDC discovery, DPoP verification, and feature-gated SPIFFE/SPIRE Workload API access. These are distinct integration surfaces.</p><a class="text-link" href={`${docs}identity/`}>Identity methods and trust boundaries →</a></div></section>
<section class="section" id="architecture"><div class="container"><div class="section-heading"><div><span class="section-kicker">07 / SYSTEM ARCHITECTURE</span><h2>One policy engine.<br/><span>Several ways in.</span></h2></div><p>Expand a component to inspect its role and integration boundary. Requests flow toward the engine; decisions return to the enforcement point.</p></div><div class="architecture"><div class="architecture-grid"><div class="arch-layer"><span class="caption">01 / APPLICATION →</span><h3>Integration surfaces</h3>{[['Agent / tool adapter','Calls the PDP before execution and honors deny and transport failures.'],['TypeScript → CLI','typescript/agentguard spawns the local binary synchronously.'],['CLI','agentguard-cli handles local authorization, simulation, audit, and token operations.'],['Admin console','frontend uses HTTP for simulation and the CLI for audit and delegation.']].map(([title,body])=><details><summary>{title}</summary><p>{body}</p></details>)}</div><div class="arch-layer core"><span class="caption">02 / AUTHORIZATION →</span><h3>AgentGuard</h3>{[['HTTP / gRPC server','agentguard-server maps requests to the core authorizer. API-key middleware protects decision routes.'],['Cedar engine','agentguard-core evaluates loaded policies against a typed request and supplied entities.'],['Embedded Rust','Use Authorizer directly in-process, or build_router to embed the HTTP surface.'],['Decision cache','LRU + TTL cache in core. Standalone startup enables it with environment overrides; embedders enable it explicitly.']].map(([title,body])=><details><summary>{title}</summary><p>{body}</p></details>)}</div><div class="arch-layer"><span class="caption">03 / STATE & EVIDENCE</span><h3>Local, inspectable state</h3>{[['Policy store → engine','.agentguard/schema.cedarschema and policies/*.cedar are local files.'],['Identity / auth','agentguard-auth provides validation libraries; the application binds identity to a principal.'],['Engine → audit','Configured server logging persists decisions; a chain secret enables HMAC-linked records.'],['Metrics / telemetry','Server Prometheus metrics and trace context; library sinks for stdout, JSONL, and optional OTLP.']].map(([title,body])=><details><summary>{title}</summary><p>{body}</p></details>)}</div></div><div class="architecture-caption"><span>REQUEST → PRINCIPAL · ACTION · RESOURCE · CONTEXT</span><span>← ALLOW / DENY → ADAPTER → TOOL</span></div></div><div class="deployment-grid">{[['Embedded','Use the Rust authorizer in your application when you own the process and security lifecycle.','App [ Authorizer → Tool ]'],['Sidecar','Keep the standalone PDP beside your agent runtime. Use a local HTTP or gRPC boundary.','Agent ⇄ local PDP → decision'],['Standalone PDP','Centralize HTTP decisions for multiple callers. Configure authentication, TLS, and durable audit storage.','Applications ⇄ HTTP PDP']].map(([title,body,flow])=><article><h3>{title}</h3><p>{body}</p><div class="mini-flow">{flow}</div></article>)}</div><a class="text-link" href={`${docs}deploy/`}>Deployment configuration and lifecycle →</a></div></section>
<section class="section" id="developers"><div class="container"><div class="section-heading"><div><span class="section-kicker">08 / DEVELOPER EXPERIENCE</span><h2>Start at your<br/><span>tool boundary.</span></h2></div><p>Use the same request model through your preferred interface. These examples follow the repository’s current APIs; the quickstart supplies their policy and request data.</p></div><Integrations/><div class="examples"><article class="example"><span class="caption">SUPPORTED REPOSITORY EXAMPLE · TYPESCRIPT</span><h3>Strands tool authorization</h3><p>An HTTP guard wraps tool execution. Transport errors and missing permission stop the callback. Includes a BeforeToolCallEvent intervention example.</p><a class="text-link" href={`${repo}/tree/master/examples/strands-tool-authz`}>Explore the Strands example ↗</a></article><article class="example"><span class="caption">SUPPORTED REPOSITORY EXAMPLE · RUST</span><h3>Embed an Axum router</h3><p>Mount AgentGuard’s HTTP router in an existing Rust application. Review the nesting path and configure audit and authentication for your deployment.</p><a class="text-link" href={`${repo}/tree/master/examples/rust-embedder`}>Explore the Rust example ↗</a></article></div><p class="note">AuthZEN-compatible clients can call the HTTP interface. Custom frameworks, LangChain loops, and MCP tool servers can integrate through their own enforcement adapter. This is interoperability, not a claim of official adapters for those projects.</p></div></section>
<section class="section" id="standards"><div class="container"><div class="section-heading"><div><span class="section-kicker">09 / STANDARDS & SURFACES</span><h2>Protocols with<br/><span>a purpose.</span></h2></div><p>Support is specific to a component and interface. Library primitives are not automatically enabled server features, and compatibility is not certification.</p></div><div class="standards-grid">{standards.map(([name,title,body,path])=><article><span class="caption">{name}</span><h3>{title}</h3><p>{body}</p><a class="text-link" href={`${repo}/blob/master/${path}`}>Inspect implementation ↗</a></article>)}</div></div></section>
<section class="section" id="observability"><div class="container split"><div class="prose"><span class="section-kicker">10 / OPERATE & INVESTIGATE</span><h2>Follow the decision<br/>across your system.</h2><p>The server accepts W3C traceparent and returns x-agentguard-span-id. Prometheus metrics expose authorization activity; audit records preserve decision evidence.</p><p>The telemetry crate provides a Sink interface and an optional OTLP/gRPC log exporter. Connect it in your embedding application; setting an endpoint alone does not enable export in the standalone server.</p><a class="text-link" href={`${docs}audit/#observability`}>Metrics, trace fields, and sink wiring →</a></div><div class="trace"><span class="caption">ILLUSTRATIVE REQUEST TRACE · NOT MEASURED TIMING</span><div class="trace-row"><span>tool adapter</span><div class="trace-bar"/></div><div class="trace-row"><span>authorization</span><div class="trace-bar"/></div><div class="trace-row"><span>audit append</span><div class="trace-bar"/></div><div class="trace-row"><span>tool execution</span><div class="trace-bar"/></div><div class="trace-foot">traceparent → child span → x-agentguard-span-id<br/>Decision · metric · audit record · optional telemetry sink</div></div></div></section>
<PolicyPlayground client:visible/>
<section class="section" id="console"><div class="container split"><div class="console"><div class="panel-head"><span>AGENTGUARD / CONSOLE</span><span>REPRESENTATIVE UI</span></div><div class="console-nav"><b>Audit log</b><span>Simulator</span><span>Delegation</span></div><div class="console-content"><span class="caption">SAMPLE DATA · NOT A LIVE CONSOLE</span><h3>Authorization decisions</h3><div class="console-row"><span>Principal</span><span>Action</span><span>Effect</span></div><div class="console-row"><span>research</span><span>repo_read</span><span>allow</span></div><div class="console-row"><span>summarizer</span><span>repo_write</span><span style="color:var(--deny)">deny</span></div><div class="note">Signed in as viewer · delegation issuing requires admin.</div></div></div><div class="prose"><span class="section-kicker">12 / OPTIONAL ADMIN CONSOLE</span><h2>Inspect decisions.<br/>Test your next request.</h2><p>The Next.js console offers audit browsing with filters, an HTTP-backed authorization simulator, and admin-only delegation issuing and verification.</p><p>OIDC sign-in is mandatory. Viewer/admin roles gate access, and missing authentication configuration returns 503. The console is a separate application you run in your infrastructure.</p><a class="text-link" href={`${repo}/blob/master/frontend/README.md`}>Configure and run the console ↗</a></div></div></section>
<section class="section" id="quickstart"><div class="container split"><div class="prose"><span class="section-kicker">13 / YOUR FIRST DECISION</span><h2>Clone. Define.<br/><span>Authorize.</span></h2><p>Start locally with Rust 1.89+ and protoc for the server build. The guide walks from the generated schema to a narrow permit, a real allow/deny pair, an HTTP request, and audit verification.</p><p>The CLI includes init, validate, authorize, sim, delegate, verify, schema, log, audit, gen, and doctor. The server has its own binary; policy operations are Rust library APIs.</p><a class="button primary" style="margin-top:24px" href={`${docs}getting-started/`}>Follow the complete quickstart →</a></div><div><div class="tabs-list" aria-label="First-run walkthrough"><button type="button" class="terminal-step" data-step="0" aria-pressed="true">1. Build</button><button type="button" class="terminal-step" data-step="1" aria-pressed="false">2. Initialize</button><button type="button" class="terminal-step" data-step="2" aria-pressed="false">3. Evaluate</button></div><Snippet title="First-run commands · walkthrough only" code={'git clone https://github.com/sachncs/agent-guard.git\ncd agent-guard\ncargo install --path crates/agentguard-cli\ncargo install --path crates/agentguard-server'}/><p class="tab-description" id="terminal-description">Build locally from source. These buttons display commands; they do not execute them.</p></div></div></section>
<section class="section" id="configuration"><div class="container"><div class="section-heading"><div><span class="section-kicker">14 / CONFIGURATION</span><h2>Explicit settings.<br/><span>Visible operating limits.</span></h2></div><p>Local files define policies and audit storage. Server flags, library options, and console settings have different scopes.</p></div><div class="config-grid">{[['Server','AGENTGUARD_LISTEN','Loopback HTTP by default. TLS listener for protected remote access.'],['Policy store','AGENTGUARD_STORE','Schema and .cedar files. Restart the server after policy changes.'],['Audit','AGENTGUARD_CHAIN_SECRET','Path to the HMAC secret. Required for a chained log.'],['Authentication','--auth apikey','Standalone API-key mode; console OIDC is configured separately.'],['Caching','Authorizer::with_cache','Standalone cache defaults to 10k entries / 60s allows / 5s denies; embedders use Authorizer::with_cache.'],['Telemetry','OTEL_EXPORTER_OTLP_ENDPOINT','Used when constructing the optional OTLP library sink.'],['gRPC','AGENTGUARD_GRPC_LISTEN','Optional plaintext listener, restricted to loopback.'],['Tracing','AGENTGUARD_TRACEPARENT','CLI trace context; HTTP clients use the traceparent header.']].map(([title,key,body])=><article><h3>{title}</h3><code>{key}</code><p>{body}</p></article>)}</div><a class="text-link" href={`${docs}configuration/`}>View all configuration and interface scopes →</a></div></section>
<section class="section security-section" id="security"><div class="container"><div class="section-heading"><div><span class="section-kicker">15 / SECURITY MODEL</span><h2>What AgentGuard enforces.<br/><span>What your system must own.</span></h2></div><p>A clear boundary is more useful than a broad security promise. Authorization is one control in your application’s security model.</p></div><div class="security-lists"><div><h3>The authorization layer</h3><ul><li>Cedar allow/deny decisions over supplied request facts.</li><li>Default deny and explicit forbid precedence.</li><li>Configured server audit writes before returning decisions.</li><li>Cryptographic audit chaining when a secret is configured.</li><li>Signed delegation and identity verification primitives.</li></ul></div><div><h3>Your enforcement boundary</h3><ul><li>Intercept every relevant tool path and honor deny or errors.</li><li>Derive identity, MFA, and context from trusted sources.</li><li>Protect policy files, secrets, logs, and network access.</li><li>Enforce delegated scopes and parent authority.</li><li>Address prompt injection, tool vulnerabilities, and actions outside the boundary.</li></ul></div></div><a class="text-link" href={`${docs}security/`}>Read the security model and current limitations →</a></div></section>
<section class="section" id="project"><div class="container"><div class="section-heading"><div><span class="section-kicker">16 / BUILT IN THE OPEN</span><h2>The control plane.<br/><span>And the source behind it.</span></h2></div><p>Six Rust crates, a TypeScript SDK, an optional console, and working integration examples. Inspect the implementation behind each interface.</p></div><div class="repo-grid">{modules.map(([path,name,body])=><a href={`${repo}/tree/master/${path}`}><code>{name} ↗</code><span>{body}</span></a>)}</div><div class="roadmap-grid"><article><span class="caption">CURRENT SOURCE</span><h3>Available to build</h3><p>Cedar authorization, HTTP/gRPC, audit export, TypeScript SDK, and the OIDC console. The shipped boundaries, compatibility notes, and current limitations are documented in the repository and versioned guides.</p></article><article><span class="caption">PRODUCTION BASELINE</span><h3>Operate with guardrails</h3><p>Docker and Kubernetes manifests provide non-root images, health probes, resource limits, secret references, persistent audit storage, and explicit single-replica scaling limits for the current release.</p></article><article><span class="caption">OPEN SOURCE</span><h3>Extend with confidence</h3><p>Contributor setup, security response, compatibility policy, release checks, and API references are maintained alongside the implementation.</p></article></div><div class="actions"><a class="button" href={`${repo}/blob/master/CHANGELOG.md`}>Read the changelog ↗</a><a class="button" href={`${repo}/releases`}>Check published releases ↗</a><a class="button" href={`${repo}/blob/master/CONTRIBUTING.md`}>Contribute ↗</a></div></div></section>
<section class="section" id="questions"><div class="container"><div class="section-heading"><div><span class="section-kicker">17 / BEFORE YOU BUILD</span><h2>Technical questions.<br/><span>Direct answers.</span></h2></div><p>Start with the boundary, then choose the integration and operating model that fit your application.</p></div>{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
<section class="final-cta"><div class="container"><span class="section-kicker">PUT POLICY IN THE EXECUTION PATH</span><h2>Between intent and execution,<br/>make a decision.</h2><div class="actions"><a class="button primary" href={`${docs}getting-started/`}>Read the quickstart →</a><a class="button" href={repo}>View AgentGuard on GitHub ↗</a></div></div></section>
</main><Footer/></Base>
<script>
 const panel=document.getElementById('hero-decision');
 document.getElementById('hero-toggle')?.addEventListener('click',()=>{const denied=panel?.dataset.denied!=='true'; if(panel) panel.dataset.denied=String(denied); document.getElementById('hero-mfa')!.textContent=denied?'false':'true'; document.getElementById('hero-effect')!.textContent=denied?'DENY':'ALLOW'; document.getElementById('hero-reason')!.textContent=denied?'MFA condition does not match. Stop execution.':'Principal, action, resource, and MFA match.'; document.getElementById('hero-audit')!.textContent=`Sample audit: effect = ${denied?'deny':'allow'}`; document.getElementById('hero-toggle')!.textContent=denied?'Restore verified MFA ↗':'Try without MFA ↗';});
 document.getElementById('verify-chain')?.addEventListener('click',()=>{document.getElementById('audit-chain')?.classList.toggle('verified'); document.getElementById('chain-status')!.textContent='Each sample previous hash matches the preceding record hash. No cryptographic verification runs here.';});
 const commands=['git clone https://github.com/sachncs/agent-guard.git\ncd agent-guard\ncargo install --path crates/agentguard-cli\ncargo install --path crates/agentguard-server','mkdir my-agent\ncd my-agent\nagentguard init --name example\n# Replace the two development policies with the guide’s rule.','agentguard validate\nagentguard authorize request.json\n# request.json comes from the complete quickstart.\nagentguard doctor'];
 document.querySelectorAll<HTMLButtonElement>('.terminal-step').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('.terminal-step').forEach(b=>b.setAttribute('aria-pressed',String(b===button))); const code=document.querySelector('#quickstart pre code'); if(code) code.textContent=commands[Number(button.dataset.step)];}));
</script>
