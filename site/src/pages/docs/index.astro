import Docs from '@/layouts/docs.astro';
const guides=[['getting-started','Your first decision','Build, narrow a policy, compare allow and deny, and verify an audit chain.'],['concepts','Authorization & policies','Understand request inputs, Cedar semantics, schemas, and policy lifecycle.'],['deploy','Architecture & deployment','Choose embedded, sidecar, or shared PDP boundaries.'],['production','Production deployment','Deploy the PDP and console with Docker and Kubernetes, including health and storage boundaries.'],['kubernetes','Kubernetes operations','Apply, verify, back up, upgrade, and roll back the supported deployment topology.'],['console','Console deployment','Configure OIDC, roles, sessions, shared rate limiting, and operator workflows.'],['api','API, SDKs & CLI','Use current request formats and integration signatures.'],['identity','Identity & delegation','Separate standalone features from verification primitives.'],['audit','Audit & observability','Verify evidence, export records, and connect telemetry.'],['configuration','Configuration reference','Find settings and the exact surface that reads them.'],['operations','Operations & troubleshooting','Diagnose policy, network, identity, and audit failures.'],['incident-response','Incident response','Contain authorization failures and preserve verifiable evidence.'],['security','Security model','Review enforcement responsibilities and current limitations.'],['compatibility','Compatibility policy','Understand supported runtimes, deployment modes, and breaking changes.'],['branding','Brand system','Use the selected identity and semantic color system consistently.']];
