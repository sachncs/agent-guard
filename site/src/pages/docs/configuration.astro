---
import Docs from '@/layouts/docs.astro';
const groups = [
 ['Standalone server',[
 ['AGENTGUARD_LISTEN / --listen','tcp://127.0.0.1:8443','TCP or tls:// listener URL.'],['AGENTGUARD_STORE / --store','.agentguard','Policy directory.'],['AGENTGUARD_AUDIT / --audit','.audit/decisions.jsonl','Decision-log destination.'],['AGENTGUARD_CHAIN_SECRET','unset','Path to the HMAC secret; unset means plain JSONL.'],['AGENTGUARD_AUTH / --auth','disabled','Binary accepts disabled, apikey with a separate key-file, or the complete apikey:<path> environment form.'],['AGENTGUARD_AUTH_KEY_FILE / --auth-key-file','unset','JSON ApiKeyStore file for --auth apikey mode; not needed when AGENTGUARD_AUTH includes the path.'],['AGENTGUARD_GRPC_LISTEN / --grpc-listen','unset','Optional loopback socket address.'],['AGENTGUARD_ALLOW_LOOPBACK_BYPASS','false','Explicit bypass for auth-disabled public HTTP binds; avoid exposing untrusted access.'],['RUST_LOG','info,agentguard=debug','tracing-subscriber filter in the server binary.']]],
 ['CLI and TypeScript subprocess',[
 ['--store / AGENTGUARD_STORE','.agentguard','Local schema/policies.'],['--audit / AGENTGUARD_AUDIT','.audit/decisions.jsonl','CLI decision log.'],['--secret-file / AGENTGUARD_CHAIN_SECRET','unset','HMAC secret file.'],['--output','pretty','Use json for automation.'],['AGENTGUARD_BIN','unset','Explicit TypeScript SDK CLI binary path; ClientOptions.cliBin also overrides discovery.'],['AGENTGUARD_TRACEPARENT','unset','W3C trace context applied to CLI requests.'],['AGENTGUARD_BEARER','unset','Forwarded by the SDK, but not validated or sent to a PDP by the local CLI.'],['OPENAI_API_KEY / ANTHROPIC_API_KEY','unset','Provider credential for optional gen command, not normal authorization.']]],
 ['Standalone cache tuning and explicit library options',[
 ['AGENTGUARD_CACHE_TTL','60s','Standalone allow-cache TTL; malformed values fail startup. Embedded state builders receive CacheConfig explicitly.'],['AGENTGUARD_DENY_CACHE_TTL','5s','Standalone deny-cache TTL; malformed values fail startup.'],['AGENTGUARD_CACHE_CAPACITY','10000','Positive standalone cache capacity; malformed or zero values fail startup.'],['AGENTGUARD_AUDIT_MAX_BYTES','unset','Standalone audit rotation threshold in bytes; unset disables rotation, and a configured value must be a positive integer. Embedded builders receive RotationConfig explicitly.'],['AGENTGUARD_JWKS_REFRESH','30s','Read by JwtConfig::with_jwks_refresh_from_env. Application owns validator/refresher wiring.'],['OTEL_EXPORTER_OTLP_ENDPOINT','OTel exporter default','Read by OtlpSink::from_env with the otlp feature enabled.'],['OTEL_SERVICE_NAME','agentguard','Resource service.name in OtlpSink.']]],
 ['Optional console',[
 ['AGENTGUARD_RATE_LIMIT_STORE','memory in development; redis in production','Shared rate-limit backend; production refuses a memory fallback.'],['AGENTGUARD_RATE_LIMIT_REDIS_URL / AGENTGUARD_RATE_LIMIT_REDIS_TOKEN','required for redis','Redis-compatible REST endpoint and credential for production rate limiting. Production endpoints must use HTTPS; credentials are supplied separately.'],
 ['AGENTGUARD_OIDC_ISSUER','required','OIDC issuer URL; production requires HTTPS for it and all discovered authorization, token, and JWKS endpoints. Loopback HTTP is allowed only in development.'],['AGENTGUARD_OIDC_CLIENT_ID','required','Confidential client identifier.'],['AGENTGUARD_OIDC_CLIENT_SECRET','required','Client secret.'],['AGENTGUARD_SESSION_SECRET','required','At least 32 characters; signs session/state cookies.'],['AGENTGUARD_SESSION_STORE','memory in development; redis in production','Shared session backend; production requires redis.'],['AGENTGUARD_SESSION_REDIS_URL / AGENTGUARD_SESSION_REDIS_TOKEN','required for redis','Redis-compatible REST endpoint and credential for shared production sessions. Production endpoints must use HTTPS; credentials are supplied separately.'],['AGENTGUARD_ADMIN_CLAIM','groups','ID-token claim used for admin roles.'],['AGENTGUARD_ADMIN_VALUES','empty','Comma-separated values granting admin; empty means no admins.'],['AGENTGUARD_PDP_URL','required in production','PDP URL; production requires HTTPS unless the private-network exception is explicitly enabled.'],['AGENTGUARD_PDP_ALLOW_INSECURE_INTERNAL','0 by default','Set to 1 only for a private cluster hop or service mesh providing mTLS.'],['AGENTGUARD_PDP_BEARER','unset','Bearer credential sent to the PDP; never expose client-side.'],['AGENTGUARD_STORE','.agentguard','CLI-backed routes’ local policy store.'],['AGENTGUARD_AUDIT','.audit/decisions.jsonl','CLI-backed audit source.'],['AGENTGUARD_INSECURE_COOKIE','unset','1 only for local plain-HTTP development.']]],
];
---
<Docs title="Configuration reference"><div class="doc-title"><span class="section-kicker">OPERATIONS / CONFIGURATION</span><h1>Configure the right surface.</h1><p>Environment variables are not universal switches. These settings identify the component that actually reads them.</p></div>{groups.map(([title,rows])=><section><h2>{title}</h2><div class="docs-table">{(rows as string[][]).map(([key,value,body])=><div><b><code>{key}</code></b><span><strong>Default: {value}.</strong> {body}</span></div>)}</div></section>)}<h2>Binary versus library authentication parsing</h2><p>The standalone binary accepts --auth apikey with a separate --auth-key-file, or AGENTGUARD_AUTH=apikey:&lt;path&gt; as a complete environment value. The library ServerConfig::from_env accepts the same apikey:&lt;path&gt; form.</p><p>The binary and library intentionally expose different configuration surfaces. Validate the selected command with agentguard-server --help, and use the production deployment guide for the supported Docker and Kubernetes path. The library ServerConfig/AuthConfig API is available to embedders.</p><h2>Source references</h2><p><a href="https://github.com/sachncs/agent-guard/blob/master/crates/agentguard-server/src/main.rs">Server binary flags</a> · <a href="https://github.com/sachncs/agent-guard/blob/master/crates/agentguard-server/src/listener.rs">Library configuration</a> · <a href="https://github.com/sachncs/agent-guard/blob/master/crates/agentguard-core/src/decision/cache.rs">Cache</a> · <a href="https://github.com/sachncs/agent-guard/blob/master/frontend/README.md">Console settings</a></p></Docs>
