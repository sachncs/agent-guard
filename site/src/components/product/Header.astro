---
import Logo from '@/components/logo.astro';
const base = import.meta.env.BASE_URL;
const links = [['Product', `${base}#product`], ['Architecture', `${base}#architecture`], ['Security', `${base}#security`], ['Developers', `${base}#developers`], ['Docs', `${base}docs/`]];
---
<header class="site-nav"><div class="container nav-inner">
<a class="brand" href={base} aria-label="AgentGuard home"><Logo size={32}/><span>AgentGuard</span></a>
<nav class="desktop-nav" aria-label="Main navigation">{links.map(([name, href]) => <a href={href}>{name}</a>)}</nav>
<div class="nav-actions"><a class="github-link" href="https://github.com/sachncs/agent-guard">GitHub ↗</a><a class="button small primary" href={`${base}docs/getting-started/`}>Get started <span aria-hidden="true">→</span></a></div>
<details class="mobile-menu"><summary aria-label="Navigation menu">Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">{links.map(([name, href]) => <a href={href}>{name}</a>)}<a href="https://github.com/sachncs/agent-guard">GitHub ↗</a></nav></details>
</div></header>
<script>
 const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
 menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { menu.open = false; }));
 document.addEventListener('keydown', e => { if(e.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
</script>
