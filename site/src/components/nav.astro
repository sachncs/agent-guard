---
import Logo from "@/components/logo.astro";
import { ThemeToggle } from "@/components/theme-toggle";
import { nav } from "@/lib/content";
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[var(--bg)]/75 backdrop-blur-xl backdrop-saturate-150"
>
  <div class="container-page flex h-14 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 text-sm font-medium tracking-tight">
      <Logo size={22} />
      <span>agent-guard</span>
      <span class="hidden text-xs font-normal text-[var(--fg-subtle)] sm:inline">
        v0.2.0
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)]"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={import.meta.env.BASE_URL + "#how"}
        class="hidden h-9 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--bg-inset)] px-4 text-sm font-medium transition-all hover:border-[var(--border-strong)] sm:inline-flex"
      >
        Quickstart
      </a>
      <a
        href="https://github.com/sachncs/agent-guard"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 items-center justify-center gap-1.5 rounded-full bg-[var(--accent)] px-4 text-sm font-medium text-[var(--accent-fg)] transition-all hover:brightness-110"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="size-4"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.13c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
          />
        </svg>
        <span class="hidden sm:inline">Star</span>
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</header>
