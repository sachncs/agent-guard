---
const items = [
  "Cedar 4.x",
  "OpenID AuthZEN",
  "OpenTelemetry",
  "RFC 7519 / 8725",
  "RFC 9449 · DPoP",
  "RFC 8693",
  "W3C Trace Context",
  "SPIFFE",
];
---

<section class="border-y border-[var(--border)] bg-[var(--bg-inset)]/40">
  <div class="container-page py-8">
    <div class="flex flex-col items-center gap-5 md:flex-row md:justify-between">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--fg-subtle)]">
        Standards-native · interop-first
      </p>
      <div class="flex flex-1 flex-wrap items-center justify-center gap-x-6 gap-y-2 md:justify-end">
        {
          items.map((item) => (
            <span class="font-mono text-xs text-[var(--fg-muted)]">
              {item}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
