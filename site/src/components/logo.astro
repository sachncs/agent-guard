---
interface Props { size?: number; monochrome?: boolean; class?: string; }
const { size = 28, monochrome = false, class: className = '' } = Astro.props;
const asset = monochrome ? 'agentguard-mark-mono.svg' : 'agentguard-mark.svg';
const src = `${import.meta.env.BASE_URL}${asset}`;
---
<img src={src} width={size} height={size} class={className} alt="" aria-hidden="true" decoding="async" />
