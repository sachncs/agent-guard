---
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-[var(--ink-900)] dark:bg-[var(--color-ink-950)]" aria-hidden="true"></div>
  <div
    class="absolute inset-0 opacity-40"
    aria-hidden="true"
    style="background:
      radial-gradient(circle at 20% 30%, rgba(216, 85, 59, 0.18), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(216, 85, 59, 0.12), transparent 50%);"
  >
  </div>
  <div class="absolute inset-0 grid-bg opacity-30" aria-hidden="true"></div>

  <div class="container-page relative py-24 md:py-32">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-cedar-300)]">
        Ship it
      </p>
      <h2 class="display text-balance text-5xl leading-[1.05] tracking-tight text-white md:text-6xl">
        Put a verifiable boundary
        <span class="display italic text-[var(--color-cedar-300)]"> around your agent. </span>
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-pretty text-base text-[var(--color-ink-200)]">
        Apache-2.0, no proprietary protocols, no vendor lock-in. Drop in the CLI, run
        the sidecar, or embed the engine — the chain stays the same.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="https://github.com/sachncs/agent-guard#quick-start"
          class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-[var(--color-cedar-500)] px-7 text-sm font-medium text-white shadow-[var(--shadow-cedar)] transition-all hover:brightness-110"
        >
          Get started
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a
          href={import.meta.env.BASE_URL + "#how"}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-full border border-white/15 bg-white/5 px-7 text-sm font-medium text-white backdrop-blur transition-all hover:border-white/30 hover:bg-white/10"
        >
          See how it works
        </a>
      </div>
    </div>
  </div>
</section>
