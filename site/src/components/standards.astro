---
import { Badge } from "@/components/ui/badge";
import { standards } from "@/lib/content";
---

<section class="container-page py-24 md:py-32" id="standards">
  <div class="mx-auto max-w-3xl text-center">
    <Badge variant="outline" className="mb-5">Standards</Badge>
    <h2 class="display text-balance text-4xl leading-tight tracking-tight md:text-5xl">
      Built on the
      <span class="display italic text-[var(--fg-muted)]"> specs you already trust. </span>
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-pretty text-[var(--fg-muted)]">
      No proprietary wire protocols. Every piece is the RFC, the working-group draft, or
      the maintained open-source implementation.
    </p>
  </div>

  <div class="mx-auto mt-16 grid max-w-5xl grid-cols-2 gap-3 sm:grid-cols-4">
    {
      standards.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="surface-inset group flex flex-col gap-1 rounded-xl p-4 transition-all hover:border-[var(--border-strong)] hover:shadow-[var(--shadow-soft)]"
        >
          <div class="text-sm font-medium tracking-tight transition-colors group-hover:text-[var(--accent)]">
            {s.name}
          </div>
          <div class="font-mono text-[10px] uppercase tracking-wider text-[var(--fg-subtle)]">
            {s.version}
          </div>
        </a>
      ))
    }
  </div>
</section>
