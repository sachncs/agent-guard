{
  "name": "agentguard-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r build && pnpm --dir site build",
    "test": "pnpm -r test",
    "check": "pnpm check:public && pnpm check:docs && node scripts/verify-k8s.mjs && pnpm --dir site check && pnpm --filter frontend lint && pnpm --filter frontend typecheck",
    "check:public": "node scripts/verify-public-surface.mjs && node scripts/verify-design-tokens.mjs",
    "check:docs": "node scripts/verify-doc-links.mjs"
  },
  "engines": {
    "node": ">=20.9"
  }
}
