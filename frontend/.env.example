# Required console OIDC configuration
AGENTGUARD_OIDC_ISSUER=https://idp.example.com
AGENTGUARD_OIDC_CLIENT_ID=agentguard-console
AGENTGUARD_OIDC_CLIENT_SECRET=replace-me
AGENTGUARD_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional; OIDC roles remain fixed for the session lifetime.
# Range: 300–28800 seconds (5 minutes–8 hours); default: 28800.
AGENTGUARD_SESSION_TTL_SECONDS=28800

# PDP connection and role mapping
AGENTGUARD_PDP_URL=http://127.0.0.1:8443
AGENTGUARD_PDP_BEARER=replace-me
# Production HTTP is rejected unless the private in-cluster trust boundary is explicitly accepted.
# AGENTGUARD_PDP_ALLOW_INSECURE_INTERNAL=1
AGENTGUARD_ADMIN_CLAIM=groups
AGENTGUARD_ADMIN_VALUES=agentguard-admin
# Persistent Ed25519 private key used by admin delegation issuance.
# AGENTGUARD_DELEGATION_KEY_FILE=/run/secrets/agentguard-delegation.key

# Production sessions use Redis-compatible shared state. Keep memory mode for development only.
# AGENTGUARD_SESSION_STORE=redis
# AGENTGUARD_SESSION_REDIS_URL=https://your-redis-endpoint
# AGENTGUARD_SESSION_REDIS_TOKEN=replace-me

# Optional production shared rate limiter (Redis-compatible REST endpoint)
# AGENTGUARD_RATE_LIMIT_STORE=redis
# AGENTGUARD_RATE_LIMIT_REDIS_URL=https://your-redis-endpoint
# AGENTGUARD_RATE_LIMIT_REDIS_TOKEN=replace-me

# Local HTTP development only; never enable behind TLS termination.
# AGENTGUARD_INSECURE_COOKIE=1
